{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marfern-portfolio",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "marfern.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/marfern-portfolio/browser",
    "not_found_handling": "single-page-application"
  }
}
